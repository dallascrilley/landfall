{
  "name": "landfall",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Migrates WordPress sites to Astro and proves every URL arrived.",
  "author": "Dallas Crilley <dallas@dallascrilley.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallascrilley/landfall.git"
  },
  "bugs": {
    "url": "https://github.com/dallascrilley/landfall/issues"
  },
  "homepage": "https://github.com/dallascrilley/landfall#readme",
  "keywords": [
    "wordpress",
    "astro",
    "migration",
    "redirects",
    "static-site",
    "url-parity",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "ingest": "tsx engine/cli.ts ingest",
    "redirects": "tsx engine/cli.ts redirects",
    "migrate": "pnpm run ingest && pnpm run redirects",
    "build": "pnpm run migrate && astro build",
    "dev": "pnpm run migrate && astro dev",
    "preview": "astro preview",
    "verify": "tsx engine/cli.ts verify",
    "verify:verbose": "tsx engine/cli.ts verify --verbose",
    "prove:missing": "tsx scripts/prove-missing-url.ts",
    "test": "vitest run",
    "type-check": "astro check",
    "check": "pnpm run type-check && pnpm run test && pnpm run build && pnpm run verify && pnpm run prove:missing"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "fast-xml-parser": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.2.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3"
    }
  }
}
