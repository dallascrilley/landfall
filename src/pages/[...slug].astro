---
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import { type ContentEntry, pages, routeToParam } from "../content";

/**
 * Every migrated page except the front page, at the exact path WordPress used
 * — including nested paths like `/about/our-roastery/`. Slug preservation is
 * what keeps the parity report honest, so it happens here and nowhere else.
 */
export const getStaticPaths = (() =>
	pages()
		.filter((page) => page.route !== "/")
		.map((page) => ({ params: { slug: routeToParam(page.route) }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: ContentEntry };
---

<Base title={page.seo.title ?? page.title} description={page.seo.description}>
	<h1>{page.title}</h1>
	<article set:html={page.html} />
</Base>
